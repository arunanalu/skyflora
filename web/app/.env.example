DATABRICKS_SERVER_HOSTNAME=<databricks-workspace-hostname>
DATABRICKS_HTTP_PATH=<databricks-sql-warehouse-http-path>
DATABRICKS_TOKEN=
DATABRICKS_CLIMATE_STATE_TABLE=<catalog.schema.table>
DATABRICKS_CLIMATE_MUNICIPAL_TABLE=<catalog.schema.table>
CLIMATE_DATA_SOURCE=mock

# Define como "true" para desabilitar o cache de dados no ambiente local.
# Em produção, deixe ausente ou vazio — o cache ficará ativo (revalidação a cada 1 hora).
DISABLE_API_CACHE=true
