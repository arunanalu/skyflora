# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env e preencha com suas chaves

# NASA FIRMS (Obrigatório para extração de Queimadas)
FIRMS_API_KEY=sua_chave_da_nasa_aqui

# Copernicus Data Space Ecosystem (Obrigatório para extração de NDVI/Cobertura Vegetal)
CDSE_CLIENT_ID=seu_client_id_aqui
CDSE_CLIENT_SECRET=seu_client_secret_aqui
